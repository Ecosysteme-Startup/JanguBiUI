# API Django (préfixe /api ; les appels sont en /v1/...).
NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_URL=http://localhost:3000
# Optional. If unset, derived from NEXT_PUBLIC_API_URL (same host, ws/wss).
# NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Keycloak (OIDC Authorization Code + PKCE, client public jangubi-web).
# Rappel à déclarer dans le client : ${NEXT_PUBLIC_URL}/auth/callback
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=jangubi
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=jangubi-web

# Mode mocks (serveur de mocks MSW + comptes de démonstration à la place de
# Keycloak). Toujours coupé en production (NODE_ENV=production).
# Avec le serveur de mocks : NEXT_PUBLIC_API_URL=http://localhost:8080/api et
# NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080 (point de jeton simulé).
NEXT_PUBLIC_API_MOCKING=false
NEXT_PUBLIC_MOCK_API_PORT=8080

NEXT_PUBLIC_SENTRY_DSN=
