# --- Public (intégré au bundle au build ; aucun secret) ---
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001
# Palette par défaut : ciel | lumiere | atlantique | cathedrale (ADR-F11)
NEXT_PUBLIC_PALETTE=ciel
NEXT_PUBLIC_SENTRY_DSN=
# Console d’administration Keycloak (lien de /plateforme/comptes), facultatif
NEXT_PUBLIC_KEYCLOAK_CONSOLE_URL=

# --- Serveur uniquement (Auth.js v5 + Keycloak, ADR-F02) ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=jangubi-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/jangubi
# Adresse interne de Keycloak pour le refresh (conteneur à conteneur) ; sinon l'issuer.
# AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/jangubi
